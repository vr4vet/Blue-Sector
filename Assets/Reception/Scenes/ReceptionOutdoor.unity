    - target: {fileID: 1130766067771791667, guid: 2d80731998c124a439773864d79b3314,
        type: 3}
      propertyPath: TextContent
      value: "Supert! N\xE5 skal du trykke p\xE5 knappen p\xE5 skjermen til venstre.
        For \xE5 gj\xF8re det m\xE5 du f\xF8rst peke mot skjermen med h\xF8yre h\xE5nd.
        Da ser du en laserpeker fra h\xE5nden din. Beveg den over knappen og trykk
        inn h\xF8yre \"avtrekker\" for \xE5 trykke p\xE5 knappen."
      objectReference: {fileID: 0}
